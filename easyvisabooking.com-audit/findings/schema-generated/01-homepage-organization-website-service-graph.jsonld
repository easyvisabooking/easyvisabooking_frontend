{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://www.easyvisabooking.com/#organization",
      "name": "Easy Visa Booking",
      "url": "https://www.easyvisabooking.com/",
      "description": "Professional US visa appointment booking and rescheduling assistance service for applicants in Canada, UAE, Turkey, Australia and the United Kingdom.",
      "logo": {
        "@type": "ImageObject",
        "url": "https://www.easyvisabooking.com/img/brand-logo-real.png",
        "_comment_VERIFY": "Confirm this is the correct absolute logo URL and that the asset is >=112x112px per Google's Organization/logo guidance. Found only as a relative asset reference (../img/brand-logo-real.png) in page markup -- not yet confirmed as the canonical brand logo file."
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer service",
        "email": "contact@easyvisabooking.com",
        "telephone": "+91-8849146234",
        "areaServed": ["CA", "AE", "TR", "AU", "GB"],
        "availableLanguage": ["English", "Hindi"]
      },
      "sameAs": [
        "https://t.me/earlyusvisabooking",
        "https://www.linkedin.com/company/easyvisabooking"
      ],
      "_comment_LINKEDIN": "The LinkedIn URL is copied from the existing homepage JSON-LD. It does not appear as a clickable link anywhere in the site's visible HTML (checked home, about, contact). Confirm the LinkedIn Company Page actually exists and is owned by this business before keeping it in sameAs -- an unverifiable sameAs claim is worse than omitting it.",
      "areaServed": ["Canada", "United Arab Emirates", "Turkey", "Australia", "United Kingdom"]
    },
    {
      "@type": "WebSite",
      "@id": "https://www.easyvisabooking.com/#website",
      "url": "https://www.easyvisabooking.com/",
      "name": "Easy Visa Booking",
      "publisher": { "@id": "https://www.easyvisabooking.com/#organization" },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "https://www.easyvisabooking.com/?s={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "Service",
      "@id": "https://www.easyvisabooking.com/#service",
      "serviceType": "US Visa Appointment Slot Booking",
      "provider": { "@id": "https://www.easyvisabooking.com/#organization" },
      "description": "Professional US visa appointment booking and rescheduling assistance for applicants in Canada, UAE, Turkey and Australia. Our team helps applicants secure earlier interview dates through the official scheduling portal.",
      "offers": {
        "@type": "Offer",
        "price": "100",
        "priceCurrency": "USD",
        "description": "Service fee per appointment successfully secured. Pricing varies by consulate location."
      },
      "areaServed": [
        { "@type": "Country", "name": "Canada" },
        { "@type": "Country", "name": "United Arab Emirates" },
        { "@type": "Country", "name": "Turkey" },
        { "@type": "Country", "name": "Australia" }
      ],
      "availableChannel": [
        {
          "@type": "ServiceChannel",
          "serviceUrl": "https://www.easyvisabooking.com/",
          "servicePhone": "+91-8849146234"
        },
        {
          "@type": "ServiceChannel",
          "name": "Email Support",
          "serviceUrl": "mailto:contact@easyvisabooking.com"
        }
      ]
    }
  ],
  "_notes": {
    "what_changed_vs_current": [
      "Merges the 2 separate/duplicated Organization declarations on the homepage into ONE canonical node with @id '#organization'; Service.provider and WebSite.publisher now reference it by @id instead of repeating name/url as an anonymous copy.",
      "Fixed the placeholder sameAs value 'https://t.me/YourTelegramChannel' -> the real handle 'https://t.me/earlyusvisabooking' confirmed live in the site footer.",
      "Added logo (verify URL/dimensions) and a consolidated telephone+email ContactPoint on the canonical Organization node.",
      "This @id pattern should be reused site-wide: every other page's Organization/Service/WebSite references should point to these same @id values instead of re-declaring bare {name,url} stub objects."
    ],
    "faqpage_note": "The existing homepage FAQPage block is NOT reproduced/changed here. Per current guidance it earns no Google SERP rich result (retired 2026-05-07) but should not be removed. Leave it in place as Info-severity only."
  }
}

{
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "@id": "https://www.easyvisabooking.com/contact/#webpage",
  "url": "https://www.easyvisabooking.com/contact/",
  "name": "Contact Easy Visa Booking",
  "isPartOf": { "@id": "https://www.easyvisabooking.com/#website" },
  "about": { "@id": "https://www.easyvisabooking.com/#organization" },
  "mainEntity": {
    "@id": "https://www.easyvisabooking.com/#organization",
    "@type": "Organization",
    "contactPoint": [
      {
        "@type": "ContactPoint",
        "contactType": "customer service",
        "email": "contact@easyvisabooking.com",
        "telephone": "+91-8849146234",
        "areaServed": ["CA", "AE", "TR", "AU", "GB"],
        "availableLanguage": ["English", "Hindi"]
      }
    ]
  },
  "_comment": "The /contact/ page currently ships ZERO JSON-LD despite being the page most likely to need a machine-readable ContactPoint. This reuses the canonical Organization @id (see file 01) rather than re-declaring a duplicate Organization stub. Pair with the 'contact' BreadcrumbList block in file 03.",
  "_whatsapp_note": "The site's real, working contact channel beyond email/phone is WhatsApp (wa.me/8849146234, used site-wide including a floating WhatsApp button). Schema.org has no dedicated WhatsApp property; ContactPoint.telephone in E.164-adjacent format ('+91-8849146234') is the correct way to represent it, which this block already does."
}
